# ============ Application ============
DEBUG=True

# ============ Database ============
DATABASE_URL=postgresql://codementor_user:yourpassword@localhost:5433/codementor

# ============ JWT ============
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ============ Ollama ============
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_CONTEXT_WINDOW=32768
CONTEXT_WINDOW_BUFFER=4096

# ============ Qdrant ============
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=codementor_rag

# ============ Embeddings ============
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# Use "cpu" if sharing GPU with Ollama
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=64

# ============ RAG ============
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.7
RAG_CHUNK_SIZE=1024
SEARCH_SCORE_THRESHOLD=0.45
SEARCH_TOP_K=8

# ============ Redis / Celery ============
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============ File Upload ============
UPLOAD_DIR=/tmp/codementor_uploads
MAX_UPLOAD_SIZE=52428800
UPLOAD_RETENTION_HOURS=24

# ============ Superadmin (optional) ============
DEFAULT_SUPERADMIN_EMAIL=
DEFAULT_SUPERADMIN_USERNAME=
DEFAULT_SUPERADMIN_PASSWORD=